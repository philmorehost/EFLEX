<IfModule mod_rewrite.c>
    RewriteEngine On

    # Rewrite all requests to the /public directory
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block access to sensitive files
<Files ".env|.git|.htaccess|composer.json|package.json">
    Require all denied
</Files>

# Disable directory browsing for security
Options -Indexes
