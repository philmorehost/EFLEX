<IfModule mod_rewrite.c>
    # Enable the rewrite engine
    RewriteEngine On

    # Set the base path for the rewrite rules
    RewriteBase /

    # Rule: If the request is for a file or directory that exists inside the /public directory,
    # serve it directly. This allows CSS, JS, and images to be loaded.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rule: If the request is not for an existing file/directory,
    # rewrite the URL to index.php in the public folder and pass the original request as a 'url' parameter.
    # This is the core of the front-controller pattern.
    RewriteRule ^(.*)$ public/index.php?url=$1 [L,QSA]
</IfModule>

# Block access to sensitive files that might be in the root directory.
<Files ".env|.git|.htaccess|composer.json|package.json|error_log|php.ini">
    Require all denied
</Files>

# Disable directory browsing for security reasons.
Options -Indexes
